APP_NAME=RPM
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
# Browser origin encoded in vehicle/customer QR links. Not read from Host or
# X-Forwarded-*. Leave empty to use APP_URL when that host is not loopback.
PUBLIC_APP_URL=

# CORS — محلي + (اختياري) دومين Vercel إن نادى الـ API مباشرة بدون Proxy
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3847,http://localhost:3847
# مثال لاحقاً: https://rpm.vercel.app
CORS_ALLOWED_ORIGINS_PATTERNS=


APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG
APP_TIMEZONE=Africa/Cairo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production / cPanel: MySQL only (InnoDB · utf8mb4)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rpm
DB_USERNAME=root
DB_PASSWORD=

# Local unit tests may use sqlite in-memory via phpunit.xml
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# cPanel: no Redis — use database queues + Cron (schedule:run / queue:work --stop-when-empty)
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=


MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Web Push — إشعارات الموبايل (PWA)
# توليد: php artisan push:vapid --write
VAPID_SUBJECT=mailto:admin@rpm.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
