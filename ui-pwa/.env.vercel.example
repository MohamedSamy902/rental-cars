# إعدادات بناء الفرونت على Vercel
# Root Directory في مشروع Vercel: ui-pwa

# اتركه فاضي — الطلبات تروح /api على نفس دومين Vercel
# و vercel.json يعمل Proxy لدومين cPanel (بعد ما يتفعّل)
VITE_API_ORIGIN=

# بديل (من غير Proxy): حط دومين الباك مباشرة — يحتاج CORS على Laravel
# VITE_API_ORIGIN=https://your-cpanel-domain.com
