# بدون Options — على بعض cPanel أي Options في .htaccess يلغي الملف كله
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    RewriteRule ^index\.php$ - [L]

    # API → Laravel (PATH_INFO يعمل على الاستضافة)
    RewriteRule ^(api|up|sanctum|storage)(/.*)?$ /index.php/$1$2 [L,QSA]

    # الصفحة الرئيسية → SPA
    RewriteRule ^$ /index.html [L]

    # ملفات موجودة
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # مسارات React → SPA
    RewriteRule . /index.html [L]
</IfModule>

# index.html و sw.js بدون كاش طويل — عشان التحديث يبان فوراً بعد كل Deploy
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|sw\.js)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# أصول Vite مُسمّاة بـ hash — كاش طويل آمن
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
